# Secret key for JWT (generate a random string, e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=your_super_secret_key_here

# Groq API Key (get it from https://console.groq.com)
# If not provided, the Master Agent will run in mock mode for testing.
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated frontend origins allowed to call the backend.
FRONTEND_ORIGINS=https://tripcraft-frontend-psi.vercel.app

# Set this to a PostgreSQL URL in production; otherwise, the backend uses local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis is optional locally; Render should provide its private REDIS_URL.
# Uncomment when running Redis locally.
# REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CACHE_DEFAULT_TTL=300
REDIS_GEOCODING_CACHE_TTL=86400

# Rate limiting is enabled when Redis is configured. Local development without
# Redis keeps existing behavior; set REDIS_RATE_LIMIT_ENABLED=false to opt out.
REDIS_RATE_LIMIT_ENABLED=true
REDIS_RATE_LIMIT_REQUESTS=60
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_LOGIN_RATE_LIMIT_REQUESTS=10
REDIS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_REGISTER_RATE_LIMIT_REQUESTS=5
REDIS_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REDIS_AI_RATE_LIMIT_REQUESTS=6
REDIS_AI_RATE_LIMIT_WINDOW_SECONDS=60
